{
  "name": "ayeba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "jobs": "node --env-file=.env.local --import tsx scripts/run-jobs.ts",
    "jobs:quick": "node --env-file=.env.local --import tsx scripts/run-jobs.ts --quick",
    "verify": "npx tsx scripts/verify-http.ts",
    "browser": "npm --prefix desktop/ayeba-browser start",
    "browser:install": "npm --prefix desktop/ayeba-browser install",
    "mobile:install": "npm --prefix mobile/ayeba-app install",
    "mobile:android": "npm --prefix mobile/ayeba-app run android"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "jose": "^6.2.8",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.2",
    "libsql": "^0.5.29"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}

{
  "name": "ayeba-mail-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Ayeba Mail — application mobile dédiée (Capacitor)",
  "scripts": {
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "android:add": "npx cap add android",
    "ios:add": "npx cap add ios",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "postinstall": "node scripts/patch-android.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- API 31+ : style complet du splash système avec le nom « Ayeba Mail » en bas -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#050507</item>
        <item name="android:navigationBarColor">#050507</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="windowSplashScreenBackground">#050507</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/ic_splash_brand</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>

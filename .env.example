# URL publique de l'app (dev)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# URL canonique pour OpenSearch / partage (prod)
NEXT_PUBLIC_SITE_URL=https://ayeba.app

# Turso (prod) — laissez vide en local pour SQLite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cron Vercel — Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Session JWT (AUTH_SECRET prioritaire ; JWT_SECRET en secours)
AUTH_SECRET=
JWT_SECRET=change-me-in-production

# Google OAuth — https://console.cloud.google.com/
# Callback prod : https://ayeba.app/api/auth/google/callback
# Ne PAS définir GOOGLE_REDIRECT_URI en production (l’app calcule l’URI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# Callback prod : https://ayeba.app/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft OAuth — https://portal.azure.com/
# Callback prod : https://ayeba.app/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Apple OAuth (optionnel)
# Callback prod : https://ayeba.app/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Sentry (optionnel)
SENTRY_DSN=

# ── Paiements (Ayeba Studio billing) ────────────────────────────
# Signature HMAC des URLs de tracking pub (secours : AUTH_SECRET)
AYEBA_SIGNING_SECRET=

# Stripe — https://dashboard.stripe.com/apikeys
# Webhook : https://ayeba.app/api/payments/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Taux de conversion pour facturer en USD les montants CDF (Stripe ne supporte pas CDF)
AYEBA_FX_CDF_PER_USD=

# CinetPay — Mobile Money RDC (M-Pesa, Airtel, Orange) + cartes
# https://dashboard.cinetpay.com → Intégration → API
# Webhook : https://ayeba.app/api/payments/webhooks/cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Payouts éditeurs (produit "Transfer" séparé)
CINETPAY_TRANSFER_API_KEY=
CINETPAY_TRANSFER_PASSWORD=

# Flutterwave — cartes + Mobile Money Afrique (secours / payouts)
# https://dashboard.flutterwave.com → Settings → API
# Webhook : https://ayeba.app/api/payments/webhooks/flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# ── Clés publicitaires des apps sœurs ───────────────────────────
# Chaque app envoie sa clé dans l'en-tête X-Ayeba-Ad-Key sur /api/ads/serve
AD_KEY_AYEBA=
AD_KEY_OMEGA=
AD_KEY_JEMSA=
AD_KEY_TALA=
AD_KEY_SOMBATEKA=

# ── Compréhension de requêtes (LLM) ─────────────────────────────
# Étape « intent » du moteur : le modèle corrige la requête, isole l'entité,
# classe l'attribut en clé canonique — toutes langues. Tout endpoint
# compatible OpenAI convient (Groq gratuit, rapide, recommandé).
# Groq : https://console.groq.com → API Keys
AYEBA_LLM_API_KEY=
AYEBA_LLM_BASE_URL=https://api.groq.com/openai/v1
AYEBA_LLM_MODEL=openai/gpt-oss-120b

# ── Back office ─────────────────────────────────────────────────
# Emails autorisés à accéder à /admin et /api/admin/* (en plus des
# lignes actives dans la table admin_users). Séparés par des virgules.
AYEBA_ADMIN_EMAILS=

# ── Ayeba Mail ──────────────────────────────────────────────────
# Clé de chiffrement des contenus de mail au repos (32+ caractères).
# Si absente, une clé locale est générée dans data/.mail-key.
AYEBA_MAIL_KEY=

# SMS — Africa's Talking (recommandé RDC) : https://africastalking.com
# username "sandbox" = environnement de test AT.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# SMS — Twilio (secours)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Mail externe — relais SMTP sortant (Brevo gratuit 300/j, Gmail, autre).
# Voir docs/mail-externe-setup.md pour le guide complet MX/SPF/DKIM/DMARC.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ayeba.app

# DKIM applicatif optionnel (signature des mails sortants)
DKIM_DOMAIN=ayeba.app
DKIM_SELECTOR=
DKIM_PRIVATE_KEY=

# Secret partagé du webhook inbound (Cloudflare Email Worker → /api/mail/inbound)
MAIL_INBOUND_SECRET=

# Copier vers .env.local et remplir

# Obligatoire pour l'auth backend (min. 16 caractères)
AUTH_SECRET=change-me-use-openssl-rand-hex-32

# URL publique de l'app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optionnel — sinon bouton Google désactivé côté serveur)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# LLM pour la synthèse (optionnel — fallback snippets sans IA)
OPENAI_API_KEY=
# ou API compatible OpenAI :
# AYEBA_LLM_API_KEY=
# AYEBA_LLM_BASE_URL=https://api.openai.com/v1
# AYEBA_LLM_MODEL=gpt-4o-mini

{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/lib/admin",
    "src/lib/services/real-ml-prediction.ts",
    "src/lib/studio/ad-server-core.ts",
    "src/lib/studio/aether-enterprise.ts",
    "src/lib/studio/billing-system.ts",
    "src/lib/studio/dashboard-manager.ts",
    "src/lib/studio/radar-enterprise.ts",
    "src/lib/studio/trace-enterprise.ts",
    "src/lib/studio/velocity-enterprise.ts",
    "src/lib/studio/yield-enterprise.ts"
  ]
}
